# Hardhat deployment secrets — copy to .env, fill in real values, never commit .env.
# This is a SEPARATE .env from the FastAPI backend's — this one lives in hardhat/.

# An Amoy RPC endpoint. Easiest: sign up free at alchemy.com or infura.io and
# create an "Amoy" (Polygon testnet) app, or use the public RPC below.
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Private key of a wallet funded with free Amoy testnet MATIC from
# faucet.polygon.technology. TESTNET ONLY — never reuse a mainnet key here.
PRIVATE_KEY=
